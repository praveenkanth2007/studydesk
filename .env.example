# Copy to .env and fill in. NEVER commit the real .env file.
PORT=5000
NODE_ENV=development

# Neon: Console -> your project -> Connect -> copy the connection string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DB_SSL=true

# 32+ random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_of_32_plus_characters
SESSION_DAYS=7

# Faculty accounts need this code at sign-up (share it only with staff). Leave empty to disable faculty sign-up.
FACULTY_SIGNUP_CODE=change-me-faculty-code

# Where uploaded files are stored (use a persistent disk in production)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Comma-separated origins allowed to call the API from a different site (only if frontend is hosted separately)
CLIENT_ORIGIN=

# Optional AI provider. Without a key the assistant uses built-in rule-based logic from your real data.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
